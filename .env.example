# Copy to .env and edit. All values have safe local defaults.
COLLABDOC_SECRET_KEY=change-me-in-production
COLLABDOC_DATABASE_URL=sqlite:///./collabdoc.db
# PostgreSQL (SRS 2.4): postgresql+psycopg://user:pass@localhost:5432/collabdoc
COLLABDOC_ACCESS_TOKEN_MINUTES=720
COLLABDOC_BROADCASTER=memory
COLLABDOC_ATTRIBUTION_MIN_CHARS=120
COLLABDOC_AUTOSAVE_DEBOUNCE_MS=800
